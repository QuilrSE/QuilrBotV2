# ==============================================================================
# QuilrBot — Environment Variable Specification
# Copy this file to `server/.env` and adjust values as needed.
# ==============================================================================

# ---- Server -------------------------------------------------------------
# Port the QuilrBot relay/API server listens on.
QUILRBOT_SERVER_PORT=4501

# Port the QuilrBot web client dev server runs on (Vite).
QUILRBOT_CLIENT_PORT=4500

# Origin allowed to call the API server (CORS). Match the client dev server.
QUILRBOT_ALLOWED_ORIGIN=http://localhost:4500

# ---- Storage -------------------------------------------------------------
# Path (relative to server/) to the local JSON store used to persist
# saved providers, gateways, and settings. Never commit this file.
QUILRBOT_STORE_PATH=./data/store.json

# 32-byte (64 hex char) key used to encrypt secrets (API keys, auth tokens)
# at rest inside the local JSON store using AES-256-GCM.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If omitted, QuilrBot will generate and persist one automatically on first run.
QUILRBOT_ENCRYPTION_KEY=

# ---- Request behavior ------------------------------------------------------
# Default upstream request timeout in milliseconds.
QUILRBOT_DEFAULT_TIMEOUT_MS=60000

# Default streaming behavior when a connection does not specify one.
QUILRBOT_DEFAULT_STREAMING=true

# Default cap on output tokens. Required by Anthropic; also sent to Bedrock,
# OpenAI and Azure OpenAI. Adjustable per user in Settings > Requests.
QUILRBOT_DEFAULT_MAX_TOKENS=4096

# Enables verbose request/response logging on the server (never logs secrets).
QUILRBOT_DEBUG_MODE=false

# ---- Optional server-side provider credentials -----------------------------
# When a chat request arrives without a key, the relay uses these instead, so
# QuilrBot can run on a machine that already holds credentials without anyone
# typing them into the browser. The UI shows "Credential configured on the
# server" for each provider that has one, and the key field becomes optional.
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
# Resource endpoint, e.g. https://acme.openai.azure.com  (uses the GA v1 API)
AZURE_OPENAI_ENDPOINT=
ANTHROPIC_API_KEY=
GOOGLE_GEMINI_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# ---- AWS Bedrock -------------------------------------------------------------
# Either a Bedrock API key (sent as a bearer token)...
AWS_BEARER_TOKEN_BEDROCK=
# ...or IAM access keys (requests are SigV4-signed by the relay).
# Needs bedrock:InvokeModel and bedrock:InvokeModelWithResponseStream.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary credentials (ASIA... keys from STS / SSO).
AWS_SESSION_TOKEN=
# Default region shown in the UI when the user hasn't chosen one.
AWS_REGION=
